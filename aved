local function actualizarGrid()
	for _, child in ipairs(gridFrame:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	for petName, _ in pairs(WANTED_PETS) do
		local tag = Instance.new("Frame")
		tag.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
		tag.Parent = gridFrame
		Instance.new("UICorner", tag).CornerRadius = UDim.new(0, 4)
		
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = "🔹 " .. petName:upper()
		lbl.TextColor3 = Color3.fromRGB(210, 220, 240)
		lbl.Font = Enum.Font.GothamMedium
		lbl.TextSize = 9
		lbl.Parent = tag
	end
end
actualizarGrid()

addBtn.MouseButton1Click:Connect(function()
	local text = string.lower(textBox.Text):match("^%s*(.-)%s*$")
	if text and text ~= "" then
		WANTED_PETS[text] = true
		textBox.Text = ""
		actualizarGrid()
	end
end)

removeBtn.MouseButton1Click:Connect(function()
	local text = string.lower(textBox.Text):match("^%s*(.-)%s*$")
	if text and WANTED_PETS[text] then
		WANTED_PETS[text] = nil
		textBox.Text = ""
		actualizarGrid()
	end
end)

actionBtn.MouseButton1Click:Connect(function()
	actionBtn.Text = "SCANNING WORKSPACE..."
	actionBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 30)
	task.wait(1.2)
	
	local found = {}
	for _, label in workspace:GetDescendants() do
		if label:IsA("TextLabel") and label.Name == "DisplayName" then
			local text = string.lower(label.Text)
			for name, _ in pairs(WANTED_PETS) do
				if text == name or string.sub(text, -#name - 1) == " " .. name then 
					found[name] = true 
				end
			end
		end
	end
	
	local success = false
	for name, _ in pairs(WANTED_PETS) do
		if found[name] then success = true end
	end
	
	if not success then
		actionBtn.Text = "NO PET FOUND. HOPPING SERVER..."
		actionBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
		task.wait(0.8)
		
		pcall(function()
			if _G.IY_ServerHop then
				_G.IY_ServerHop()
			elseif _G.serverHop then
				_G.serverHop()
			else
				local textChannel = game:GetService("TextChatService"):FindFirstChild("TextChannels") and game:GetService("TextChatService").TextChannels:FindFirstChild("RBXGeneral")
				if textChannel then textChannel:SendAsync(";serverhop") end
			end
		end)
	else
		actionBtn.Text = "🎯 TARGET ACQUIRED! RADAR STOPPED"
		actionBtn.BackgroundColor3 = Color3.fromRGB(36, 150, 90)
		
		local sound = Instance.new("Sound", workspace)
		sound.SoundId = "rbxassetid://9069609268"
		sound:Play()
	end
end)
